# AWS credentials for Rift-Pulse edge ingestion (Windows)
AWS_ACCESS_KEY_ID=your_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_secret_access_key_here
AWS_REGION=eu-central-1
AWS_S3_BUCKET=rift-pulse-data-lake

# Live Client polling
LOL_CLIENT_URL=https://127.0.0.1:2999/liveclientdata/allgamedata
AUTO_POLL_IDLE=true
IDLE_POLL_INTERVAL=2.5
ACTIVE_POLL_INTERVAL=1.0

# Post-match S3 upload retry policy
S3_UPLOAD_MAX_ATTEMPTS=3
S3_UPLOAD_RETRY_DELAY=5
