rift_pulse:
  target: prod
  outputs:
    prod:
      type: databricks
      host: "{{ env_var('DATABRICKS_HOST') }}"
      http_path: "{{ env_var('DATABRICKS_HTTP_PATH') }}"
      auth_type: oauth
      catalog: "{{ env_var('DATABRICKS_CATALOG', 'rift_pulse') }}"
      schema: gold
      threads: 4
