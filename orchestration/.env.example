# Keep this file as documentation. Copy it to orchestration/.env and replace values.
AIRFLOW_VERSION=2.10.5
AIRFLOW_UID=50000

# Generate independent values; commands are documented in docs/airflow-ubuntu.md.
POSTGRES_PASSWORD=replace_with_url_safe_random_value
AIRFLOW__CORE__FERNET_KEY=replace_with_fernet_key
AIRFLOW_WEBSERVER_SECRET_KEY=replace_with_random_hex_value
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=replace_with_strong_admin_password

# Airflow uses these values only to invoke an already deployed Databricks job.
DATABRICKS_HOST=https://your-workspace.cloud.databricks.com
DATABRICKS_TOKEN=replace_with_databricks_pat
DATABRICKS_JOB_ID=replace_with_numeric_job_id
