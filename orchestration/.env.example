# AWS IAM credentials for Airflow worker
AWS_ACCESS_KEY_ID=your_airflow_access_key_id
AWS_SECRET_ACCESS_KEY=your_airflow_secret_access_key
AWS_REGION=eu-central-1
AWS_S3_BUCKET=rift-pulse-data-lake

# Databricks job triggered by the ingestion DAG
DATABRICKS_HOST=https://your-workspace.cloud.databricks.com
DATABRICKS_TOKEN=your_databricks_token
DATABRICKS_JOB_ID=123456789

# Airflow environment configuration
AIRFLOW_UID=50000
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=admin
